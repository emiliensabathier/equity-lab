[Unit]
Description=equity-lab jobs (peer table, then pre-generated pages)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=equity-lab
WorkingDirectory=/opt/equity-lab
EnvironmentFile=/opt/equity-lab/.env
Environment=HOME=/opt/equity-lab
Environment=PATH=/opt/equity-lab/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=OPENBLAS_NUM_THREADS=1
Environment=OMP_NUM_THREADS=1
Environment=MKL_NUM_THREADS=1
Environment=EQUITY_LAB_DATA=/opt/equity-lab/data
ExecStart=-/opt/equity-lab/.venv/bin/python -m elab build-peers
ExecStart=/opt/equity-lab/.venv/bin/python -m elab pregenerate
MemoryMax=1G
# Read-only system and no /home; writable only under /opt/equity-lab, which holds the data and,
# as HOME, the claude CLI's login.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=/opt/equity-lab
ProtectHome=yes
TimeoutStartSec=8h
